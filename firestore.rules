rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.farmerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn();
      allow update: if signedIn();
    }
  }
}
