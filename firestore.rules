rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasRole('admin');
      allow create: if isOwner(userId)
        && request.resource.data.role in ['customer', 'farmer', 'admin', 'buyer'];
      allow update: if isOwner(userId) || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if (hasRole('farmer') && request.resource.data.farmerId == request.auth.uid) || hasRole('admin');
      allow update, delete: if (hasRole('farmer') && resource.data.farmerId == request.auth.uid) || hasRole('admin');
    }

    match /orders/{orderId} {
      allow create: if ((hasRole('customer') || hasRole('buyer')) && request.resource.data.customerId == request.auth.uid) || hasRole('admin');
      allow read: if ((hasRole('customer') || hasRole('buyer')) && resource.data.customerId == request.auth.uid)
        || (hasRole('farmer') && request.auth.uid in resource.data.farmerIds)
        || hasRole('admin');
      allow update: if hasRole('admin')
        || (resource.data.customerId == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Cancelled')
        || (hasRole('farmer') && request.auth.uid in resource.data.farmerIds);
      allow delete: if (resource.data.customerId == request.auth.uid) || hasRole('admin');
    }

    match /bulk_requirements/{reqId} {
      allow read: if true;
      allow create: if (hasRole('buyer') || hasRole('admin') || signedIn());
      allow update, delete: if (resource.data.buyerId == request.auth.uid) || hasRole('admin');
    }

    match /bulk_offers/{offerId} {
      allow read: if signedIn();
      allow create: if (hasRole('farmer') && request.resource.data.farmerId == request.auth.uid) || hasRole('admin');
      allow update, delete: if (resource.data.farmerId == request.auth.uid) || hasRole('admin');
    }

    match /subscriptions/{subId} {
      allow read: if isOwner(resource.data.userId) || hasRole('admin');
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || hasRole('admin');
    }

    match /negotiations/{negId} {
      allow read: if resource.data.customerId == request.auth.uid || resource.data.farmerId == request.auth.uid || hasRole('admin');
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if resource.data.customerId == request.auth.uid || resource.data.farmerId == request.auth.uid || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    match /farmer_verifications/{farmerId} {
      allow read: if isOwner(farmerId) || hasRole('admin');
      allow create, update: if isOwner(farmerId) || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    match /farmer_transactions/{txId} {
      allow read: if (resource.data.farmerId == request.auth.uid) || hasRole('admin');
      allow create: if (request.resource.data.farmerId == request.auth.uid) || hasRole('admin');
      allow update, delete: if hasRole('admin');
    }

    match /price_alerts/{alertId} {
      allow read, write: if isOwner(resource.data.userId) || hasRole('admin');
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isOwner(resource.data.userId) || hasRole('admin');
      allow create: if signedIn();
    }
  }
}
